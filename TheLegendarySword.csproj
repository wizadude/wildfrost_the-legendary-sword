<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TheLegendarySword</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <WildfrostManaged>/home/logan/.local/share/Steam/steamapps/common/Wildfrost/Modded/Wildfrost_Data/Managed</WildfrostManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: don't copy these into our output, the game already has them loaded -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WildfrostManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WildfrostManaged)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DeadExtensions">
      <HintPath>$(WildfrostManaged)/DeadExtensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(WildfrostManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WildfrostManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
